import EvmLean.Crypto.Bls12381.Precompile
import EvmTest.PrecompileHex

/-!
# Tests for the EIP-2537 BLS12-381 precompile operations

`EvmLean/Crypto/Bls12381/Precompile.lean` and `HashToCurve.lean`.

The vectors are go-ethereum's EIP-2537 precompile test data,
`core/vm/testdata/precompiles/` at `master` (fetched 2026-10-19): `blsG1Add.json`,
`blsG2Add.json`, `blsMapG1.json`, `blsMapG2.json` (every vector),
`blsG1MultiExp.json`, `blsG2MultiExp.json`, `blsG1Mul.json`, `blsG2Mul.json` (a subset: all
hand-written edge cases, the `jwasinger` MSMs of 1–8, 16, 31 and 64 pairs plus one of 128
pairs for `G1`, and every tenth `matter_*` vector; the `*Mul` files are single-pair MSMs),
`blsPairing.json` (all hand-written cases and every other `matter_*` vector), and all of the
`fail-bls*.json` files (bad length, top bytes set, coordinate `≥ p`, point not on the curve,
point not in the subgroup). The comment above each check is the vector's `Name`.
Each `#guard` line is generated from the JSON by a script; the hex strings are verbatim.
-/

open EvmLean EvmLean.Bls12381 EvmTest.Precompile

namespace EvmTest.Bls12381Precompile

/-! ## Constants and building blocks -/

-- `P_MINUS_9_DIV_16` of py_ecc `optimized_bls12_381/constants.py`.
#guard pMinus9Div16 = 1001205140483106588246484290269935788605945006208159541241399033561623546780709821462541004956387089373434649096260670658193992783731681621012512651314777238193313314641988297376025498093520728838658813979860931248214124593092835
-- `RV1(1 + u)` is a primitive eighth root of unity; all the copied constants are canonical.
#guard Fp2.pow ⟨⟨rv1⟩, ⟨rv1⟩⟩ 4 = ⟨⟨P - 1⟩, ⟨0⟩⟩
#guard [ev1, ev2, ev3, ev4, rv1].all (· < P)
-- `√(−11³)` squares to `−11³`.
#guard sqrtMinus11Cubed * sqrtMinus11Cubed = -(Fp.ofNat (11 * 11 * 11))
-- SSWU lands on the isogenous curves, and the full maps land in the prime-order subgroups.
#guard [0, 1, 2, 5, 7, P - 1].all fun n =>
  let (x, y) := swuG1 ⟨n⟩
  y * y = x * x * x + isoA1 * x + isoB1
#guard [0, 1, 2, 5, 7, P - 1].all fun n => (mapToCurveG1 ⟨n⟩).isOnCurve b1
#guard [0, 3, P - 1].all fun n => (mapFpToG1 ⟨n⟩).inSubgroup
#guard [(0, 0), (1, 0), (0, 1), (5, P - 7)].all fun (a, b) =>
  match swuG2 ⟨⟨a⟩, ⟨b⟩⟩ with
  | some (x, y) => y * y = x * x * x + isoA2 * x + isoB2
  | none => false
#guard [(0, 0), (1, 2)].all fun (a, b) =>
  match mapFp2ToG2 ⟨⟨a⟩, ⟨b⟩⟩ with
  | some q => q.isOnCurve b2 && q.inSubgroup
  | none => false
-- `sgn0` (RFC 9380 §4.1).
#guard (Fp2.sgn0 ⟨⟨0⟩, ⟨1⟩⟩, Fp2.sgn0 ⟨⟨2⟩, ⟨1⟩⟩, Fp2.sgn0 ⟨⟨1⟩, ⟨0⟩⟩) = (true, false, true)
-- Field-element decoding: `p − 1` is accepted, `p` is not.
#guard (decodeFp (Bytes.ofNatBE 64 (P - 1)) 0).isSome
#guard (decodeFp (Bytes.ofNatBE 64 P) 0).isNone
-- Encodings round-trip, and the encoded generators decode to themselves.
#guard decodeG1 (encodeG1 g1Gen) 0 = some g1Gen
#guard decodeG2 (encodeG2 g2Gen) 0 = some g2Gen
#guard decodeG1 (Bytes.zeros 128) 0 = some .infinity


