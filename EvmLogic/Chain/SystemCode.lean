/-- **The canonical code of each system contract**, empty at every other account. -/
def systemCode (a : Address) : ByteArray :=
  if a = beaconRootsAddress then beaconRootsCode
  else if a = historyStorageAddress then historyStorageCode
  else if a = withdrawalRequestAddress then withdrawalRequestCode
  else if a = consolidationRequestAddress then consolidationRequestCode
  else .empty

theorem systemCode_beaconRoots : systemCode beaconRootsAddress = beaconRootsCode := by
  simp [systemCode]
theorem systemCode_historyStorage : systemCode historyStorageAddress = historyStorageCode := by
  simp [systemCode, beaconRootsAddress, historyStorageAddress]
theorem systemCode_withdrawalRequest :
    systemCode withdrawalRequestAddress = withdrawalRequestCode := by
  simp [systemCode, beaconRootsAddress, historyStorageAddress, withdrawalRequestAddress]
theorem systemCode_consolidationRequest :
    systemCode consolidationRequestAddress = consolidationRequestCode := by
  simp [systemCode, beaconRootsAddress, historyStorageAddress, withdrawalRequestAddress,
    consolidationRequestAddress]

/-- Every world-dependent fact about the four codes follows from one about each of them. -/
theorem forall_systemContracts {Q : Address → ByteArray → Prop}
    (h₁ : Q beaconRootsAddress beaconRootsCode)
    (h₂ : Q historyStorageAddress historyStorageCode)
    (h₃ : Q withdrawalRequestAddress withdrawalRequestCode)
    (h₄ : Q consolidationRequestAddress consolidationRequestCode) :
    ∀ a ∈ systemContracts, Q a (systemCode a) := by
  intro a ha
  simp only [systemContracts, List.mem_cons, List.not_mem_nil, or_false] at ha
  rcases ha with rfl | rfl | rfl | rfl
  · rw [systemCode_beaconRoots]; exact h₁
  · rw [systemCode_historyStorage]; exact h₂
  · rw [systemCode_withdrawalRequest]; exact h₃
  · rw [systemCode_consolidationRequest]; exact h₄

/-! ## Sizes -/

theorem size_beaconRootsCode : beaconRootsCode.size = 97 := by decide +kernel
theorem size_historyStorageCode : historyStorageCode.size = 83 := by decide +kernel
theorem size_withdrawalRequestCode : withdrawalRequestCode.size = 504 := by decide +kernel
theorem size_consolidationRequestCode : consolidationRequestCode.size = 414 := by decide +kernel

/-! ## Real code -/

theorem delegatedAddress?_systemCode : ∀ a ∈ systemContracts,
    delegatedAddress? (systemCode a) = none :=
  forall_systemContracts (Q := fun _ c => delegatedAddress? c = none)
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)

theorem size_systemCode : ∀ a ∈ systemContracts, (systemCode a).size ≠ 0 :=
  forall_systemContracts (Q := fun _ c => c.size ≠ 0)
    (by rw [size_beaconRootsCode]; decide) (by rw [size_historyStorageCode]; decide)
    (by rw [size_withdrawalRequestCode]; decide) (by rw [size_consolidationRequestCode]; decide)

/-- **The canonical codes are real code**: not empty, not an EIP-7702 designator. -/
theorem realCode_systemCode {a : Address} (ha : a ∈ systemContracts) :
    Tx.RealCode (systemCode a) :=
  Tx.realCode_of_deleg (size_systemCode a ha) (delegatedAddress?_systemCode a ha)

/-! ## No outward instruction -/

/-- The bytes of the instructions that can act outside the executing account or request a
child frame: `GAS` (`0x5a`, which `GasMono.readsGasB` groups with the calls), `CREATE`
(`0xf0`), `CALL` (`0xf1`), `CALLCODE` (`0xf2`), `DELEGATECALL` (`0xf4`), `CREATE2` (`0xf5`),
`STATICCALL` (`0xfa`) and `SELFDESTRUCT` (`0xff`). -/
def outwardB (b : UInt8) : Bool :=
  b == 0x5a || b == 0xf0 || b == 0xf1 || b == 0xf2 || b == 0xf4 || b == 0xf5 || b == 0xfa ||
    b == 0xff

/-- **Isolated code**: no instruction of the linear decoding of `code` (`PUSH` immediates
skipped) is outward (`outwardB`). A frame running it executes only instructions at
boundaries (`EvmLogic.Chain.Lone`), so it never requests a child, never self-destructs, and
writes only its own storage. -/
def Isolated (code : ByteArray) : Prop :=
  ∀ q ∈ boundaries code, outwardB (Bytes.getD code q) = false

/-- `Isolated`, decided on the structural scan. -/
theorem isolated_of_scan {code : ByteArray}
    (h : (insns code).all (fun t => !outwardB t.2.1) = true) : Isolated code := by
  rw [insns_eq, List.all_map, List.all_eq_true] at h
  intro q hq
  simpa [insnInfo] using h q hq

/-- Outward opcodes come from outward bytes: an instruction decoded from any other byte, in any
fork, reads no gas and starts no child (`GasMono.readsGasB`). -/
theorem readsGasB_decode_of_not_outward (fork : Fork) {b : UInt8} (h : outwardB b = false) :
    readsGasB (Opcode.decode fork b) = false := by
  cases hr : readsGasB (Opcode.decode fork b) with
  | false => rfl
  | true =>
    rcases readsGas_decode fork b hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> revert h <;>
      decide

theorem isolated_beaconRootsCode : Isolated beaconRootsCode :=
  isolated_of_scan (by decide +kernel)
theorem isolated_historyStorageCode : Isolated historyStorageCode :=
  isolated_of_scan (by decide +kernel)
theorem isolated_withdrawalRequestCode : Isolated withdrawalRequestCode :=
  isolated_of_scan (by decide +kernel)
theorem isolated_consolidationRequestCode : Isolated consolidationRequestCode :=
  isolated_of_scan (by decide +kernel)

/-- **No system contract can act outside its own account.** -/
theorem isolated_systemCode : ∀ a ∈ systemContracts, Isolated (systemCode a) :=
  forall_systemContracts (Q := fun _ c => Isolated c) isolated_beaconRootsCode
    isolated_historyStorageCode isolated_withdrawalRequestCode isolated_consolidationRequestCode

end EvmLogic.Chain
