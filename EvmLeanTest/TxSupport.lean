import EvmLean
import Conformance.Hex

/-!
Shared helpers for the transaction / block / trie tests: hex literals and a stand-in
`Crypto` for tests that must not depend on real hashing.
-/

open EvmLean

namespace EvmLeanTest

/-- Hex literal (empty on malformed input, which would make the test fail visibly). -/
def hx (s : String) : ByteArray := (Conformance.parseHexBytes s).toOption.getD .empty

/-- Hex word literal. -/
def hw (s : String) : Word := BitVec.ofNat 256 ((Conformance.parseHexNat s).toOption.getD 0)

/-- A deterministic stand-in "hash": the big-endian value of the input's first 32 bytes
plus its length. Only for tests that check structure, never cryptographic properties. -/
def fakeKeccak (b : ByteArray) : Word := BitVec.ofNat 256 (Bytes.toNat (b.extract 0 32) + b.size)

/-- Stand-in crypto for tests that must not execute the real primitives. -/
def fakeCrypto : Crypto where
  keccak256 := fakeKeccak
  sha256 := fun _ => .empty
  ripemd160 := fun _ => .empty
  blake2f := fun _ h _ _ _ _ => h
  ecrecover := fun _ _ _ _ => none
  bn254Add := fun _ => none
  bn254Mul := fun _ => none
  bn254Pairing := fun _ => none
  kzgVerify := fun _ _ _ _ => none

/-- Does decoding fail? -/
def rlpRejects (b : ByteArray) : Bool :=
  match Rlp.decode b with
  | .ok _ => false
  | .error _ => true

/-- Does decoding succeed and re-encode to the same bytes? -/
def rlpRoundtrips (b : ByteArray) : Bool :=
  match Rlp.decode b with
  | .ok r => r.encode == b
  | .error _ => false

end EvmLeanTest

namespace EvmLeanTest

/-- Genesis RLP of `ValidBlocks/bcEIP4844-blobtransactions/blockWithAllTransactionTypes`. -/
def genesisRlpHex : String :=
  ""

/-- Block 1 RLP of the same fixture: one transaction of each type 0–3. -/
def block1RlpHex : String :=
  ""

/-- The genesis block of the fixture (default block on a decoding failure, which the tests
then detect). -/
def genesisBlock : Block := (Block.decode (hx genesisRlpHex)).toOption.getD default

/-- Block 1 of the fixture. -/
def block1 : Block := (Block.decode (hx block1RlpHex)).toOption.getD default

end EvmLeanTest

-- Decidable equality of `Except`, so that tests can compare results directly.
deriving instance DecidableEq for Except
